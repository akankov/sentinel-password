{
  "name": "@sentinel-password/core",
  "version": "1.3.1",
  "type": "module",
  "description": "Modern, zero-dependency TypeScript password validation with bloom filter-based common password detection. 100% test coverage (enforced); ~6.3 KB gzipped (10 KB CI limit).",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "bench": "vitest bench",
    "generate:bloom": "node ../../scripts/generate-bloom-filter.cjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "password",
    "validation",
    "security",
    "typescript",
    "zxcvbn",
    "strength",
    "entropy",
    "password-validator",
    "password-strength",
    "authentication",
    "zero-dependency",
    "bloom-filter"
  ],
  "author": "Aleksei Kankov <akankov@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akankov/sentinel-password.git",
    "directory": "packages/core"
  },
  "homepage": "https://akankov.github.io/sentinel-password/",
  "bugs": {
    "url": "https://github.com/akankov/sentinel-password/issues"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.8",
    "check-password-strength": "^3.0.0",
    "password-validator": "^5.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zxcvbn": "^4.4.2"
  }
}
